ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/nexus_ai
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Webhook secrets (để trống = dev mode, bỏ qua xác thực chữ ký) ---
TELEGRAM_WEBHOOK_SECRET=
# Zalo OA: token truy cập hết hạn sau ~1 GIỜ, phải lấy lại từ Zalo OA Admin
# và cập nhật thủ công vào đây (không hỗ trợ refresh token).
ZALO_OA_ACCESS_TOKEN=
ZALO_WEBHOOK_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
# Tag gửi chủ động (lời nhắc) ngoài cửa sổ 24h của Messenger
MESSENGER_TAG=ACCOUNT_UPDATE